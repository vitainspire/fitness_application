# Secrets / local environment — never commit real credentials
.env
.env.dev
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Logs
*.log
# The whole directory, not just *.log: the scheduled-job wrapper also drops
# .tmp stderr files here, and the run log itself carries thousands of user
# ids. None of it belongs in version control.
logs/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Voice extraction benchmark — the real dataset and its results are local-only
testing/voice_extraction_benchmark/dataset.json
testing/voice_extraction_benchmark/results/

# Patient-derived data exports / reference datasets - never commit
db_export/
eval_data/reference/

# learned-words dictionary (SQLite) for the new chat pipeline
data/trigger_words.db*

# Local scratch/backups (contains copies of .env files with real keys) - never commit
testing_temparary/

# Working/test artifacts: AI test prompts + reports, draft data tables, reference-build helpers - local only
E2E_*.md
LIVE_*.md
*_FOR_CLAUDE.md
docs/LIVE_APP_TEST_REPORT.md
data/*_DRAFT*.csv
data/*_RANKED.csv
data/*_audit_log.csv
data/condition_exercise_ranking_phase1.csv
scripts/dev_tools/reference_prompt.md
scripts/dev_tools/build_reference_inputs.py
